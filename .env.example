# Copia este archivo como .env y pon valores propios.
# En Vercel estas variables se definen en Settings > Environment Variables
# (ver docs/despliegue-vercel.md), no en un archivo.

# Firma las sesiones del admin. Obligatorio en producción (mínimo 32 caracteres).
# Genéralo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Separación por dominio. Vacías = todo en el mismo host (desarrollo y Preview).
# En producción:  ADMIN_HOST=admin.dominio.com   PUBLIC_HOST=dominio.com
# Para probarla en local:  ADMIN_HOST=admin.localhost:3000   PUBLIC_HOST=localhost:3000
ADMIN_HOST=
PUBLIC_HOST=

# Base de datos. Vacía = archivo local en database/data/ugbplus.db (desarrollo).
# En producción, la URL de Turso y su token:
#   DATABASE_URL=libsql://nombre-usuario.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Imágenes subidas desde el panel. Vacía = se guardan en public/images (desarrollo y VPS).
# En Vercel es obligatoria: el disco no persiste. La crea sola la integración Blob.
BLOB_READ_WRITE_TOKEN=

# Primera cuenta del panel, solo al crear la base vacía.
# En desarrollo, si se dejan vacías se usa una cuenta de prueba.
# En producción son obligatorias: sin ellas no se crea ninguna cuenta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
